# Copiez ce fichier en ".env" puis remplissez-le.

# Clé API Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Adresse(s) autorisée(s) à donner des ordres, séparées par des virgules
ALLOWED_SENDERS=gaet.pierson@gmail.com

# Dossier de vos projets en cours, et dossier des notes
PROJECTS_DIR=C:\Users\VOTRE_NOM\Documents\Projets
NOTES_DIR=C:\Users\VOTRE_NOM\Documents\Notes agent

# Agenda à gérer : votre adresse Gmail (après l'avoir partagé avec le compte de l'agent)
CALENDAR_ID=gaet.pierson@gmail.com

# Modèle Claude et plafond de dépense par tâche (dollars)
CLAUDE_MODEL=claude-sonnet-5-5
MAX_BUDGET_USD=0.50

# Fréquence de lecture des mails (secondes)
POLL_SECONDS=60

# Option simple, sans Google Cloud : adresse de l'agent + mot de passe d'application Gmail
# (Compte Google de l'agent > Sécurité > Validation en deux étapes > Mots de passe des applications)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=


# Telegram : jeton du robot donné par @BotFather, et votre identifiant Telegram (le robot vous le donne au premier message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED=

# Dossiers que l'agent peut lire sans jamais les modifier, séparés par des points-virgules
READ_ONLY_DIRS=

# Agenda sans Google Cloud : « Adresse secrète au format iCal » (Google Agenda > Paramètres > votre agenda > Intégrer l'agenda).
# L'agent lit l'agenda avec, et ajoute des rendez-vous en vous envoyant une invitation (à CALENDAR_ID).
CALENDAR_ICS_URL=

# Réponses vocales aux vocaux Telegram (1 = oui, 0 = non) et voix Piper utilisée
REPONSE_VOCALE=1
VOIX=fr_FR-siwis-medium

# Tâches Claude : déclencheur API d'une routine (claude.ai/code/routines > la routine > Modifier > API)
ROUTINE_URL=
ROUTINE_TOKEN=

# Comptes-rendus de visite : dossier des chantiers où l'agent peut AJOUTER ses CR (jamais modifier ni supprimer).
# Vide : les CR restent dans le dossier de l'agent.
CR_DOSSIER_CHANTIERS=
CR_SOUS_DOSSIER=00 - ETUDE

# Gmail perso de Gaëtan, en LECTURE SEULE (recherche de contexte). Mot de passe d'application Google.
GMAIL_PERSO_ADRESSE=
GMAIL_PERSO_MOT_DE_PASSE=

# Boîtes Outlook du PC que l'agent peut lire, en LECTURE SEULE (adresses séparées par des virgules).
# Le PC est partagé : toute boîte absente de cette liste est ignorée. Vide : pas de recherche Outlook.
OUTLOOK_COMPTES=

# Noms propres à bien écrire dans la transcription des vocaux (séparés par des virgules).
VOCABULAIRE=EPUR, CCTI, Alliance Industrie, Perrier, Béziers, Veolia, CABM, DN, NGF, inox

# Modèle de transcription des vocaux : large-v3-turbo (précis) ou small (rapide sur processeur).
WHISPER_MODEL=large-v3-turbo

# Transcription des vocaux sur la carte graphique NVIDIA : cuda (après pip install nvidia-cublas-cu12 nvidia-cudnn-cu12), sinon cpu.
WHISPER_APPAREIL=cpu
