# Copiez ce fichier en ".env" puis remplissez-le.

# Clé API Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Adresse(s) autorisée(s) à donner des ordres, séparées par des virgules
ALLOWED_SENDERS=gaet.pierson@gmail.com

# Dossier de vos projets en cours, et dossier des notes
PROJECTS_DIR=C:\Users\VOTRE_NOM\Documents\Projets
NOTES_DIR=C:\Users\VOTRE_NOM\Documents\Notes agent

# Agenda à gérer : votre adresse Gmail (après l'avoir partagé avec le compte de l'agent)
CALENDAR_ID=gaet.pierson@gmail.com

# Modèle Claude et plafond de dépense par tâche (dollars)
CLAUDE_MODEL=claude-sonnet-5-5
MAX_BUDGET_USD=0.50

# Fréquence de lecture des mails (secondes)
POLL_SECONDS=60
